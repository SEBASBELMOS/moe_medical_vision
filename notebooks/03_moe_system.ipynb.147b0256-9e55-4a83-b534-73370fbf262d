     "output_type": "stream",
     "text": [
      "Construyendo Expert 1 desde expert1_ensemble_meta_20260418_230946.json...\n",
      "  Params: 278.2M (10 ConvNeXt-Tiny)\n",
      "  Thresholds: [0.63 0.66 0.4  0.76 0.67]\n",
      "  Output probs:  (2, 5)  (esperado: (2, 5))\n",
      "  Global prob:   (2,) (esperado: (2,))\n"
     ]
    }
   ],
   "source": [
    "import timm\n",
    "\n",
    "class ConvNeXtCXR(nn.Module):\n",
    "    \"\"\"Binary ConvNeXt-Tiny head used por Expert 1 v9 (idéntica a notebook 01).\"\"\"\n",
    "    def __init__(self, num_classes=1):\n",
    "        super().__init__()\n",
    "        self.backbone = timm.create_model(\n",
    "            'convnext_tiny.fb_in22k_ft_in1k', pretrained=False,\n",
    "            num_classes=0, global_pool='avg', drop_path_rate=0.0)\n",
    "        self.head = nn.Sequential(\n",
    "            nn.Dropout(0.4),\n",
    "            nn.Linear(self.backbone.num_features, num_classes),\n",
    "        )\n",
    "    def forward(self, x):\n",
    "        return self.head(self.backbone(x))\n",
    "\n",
    "\n",
    "class Expert1NIHEnsemble(nn.Module):\n",
    "    \"\"\"Expert 1 v9: 10 ConvNeXt binarios → (B,5) probs de enfermedad.\n",
    "    Salida: probs (Atel,Effu,Infi,Mass,Nodu) + global_prob (pathology gate).\n",
    "    \"\"\"\n",
    "    CLASS_NAMES = ['Atelectasis', 'Effusion', 'Infiltration', 'Mass', 'Nodule']\n",
    "\n",
    "    def __init__(self, meta_path, device='cuda'):\n",
    "        super().__init__()\n",
    "        self.device = device\n",
    "        with open(meta_path) as f:\n",
    "            meta = json.load(f)\n",
    "        specialists = {s['name']: s for s in meta['specialists']}\n",
    "\n",
    "        self.global_model = self._load(specialists['Global']['ckpt'])\n",
    "        self.atel_model   = self._load(specialists['Atelectasis']['ckpt'])\n",
    "        self.effu_model   = self._load(specialists['Effusion']['ckpt'])\n",
    "        self.infi_model   = self._load(specialists['Infiltration']['ckpt'])\n",
    "        self.mass_models  = nn.ModuleList([self._load(c) for c in specialists['Mass']['ckpt']])\n",
    "        self.nodu_models  = nn.ModuleList([self._load(c) for c in specialists['Nodule']['ckpt']])\n",
    "\n",
    "        self.register_buffer('thresholds', torch.tensor([\n",
    "            specialists['Atelectasis']['thr'],\n",
    "            specialists['Effusion']['thr'],\n",
    "            specialists['Infiltration']['thr'],\n",
    "            specialists['Mass']['thr'],\n",
    "            specialists['Nodule']['thr'],\n",
    "        ], dtype=torch.float32))\n",
    "\n",
    "        for p in self.parameters():\n",
    "            p.requires_grad = False\n",
    "        self.eval()\n",
    "\n",
    "    def _load(self, ckpt_path):\n",
    "        m = ConvNeXtCXR(num_classes=1)\n",
    "        state = torch.load(ckpt_path, map_location='cpu', weights_only=False)\n",
    "        m.load_state_dict(state['model_state_dict'], strict=True)\n",
    "        return m.to(self.device).eval()\n",
    "\n",
    "    @torch.no_grad()\n",
    "    def forward(self, x):\n",
    "        \"\"\"x: (B,3,224,224) → (probs (B,5), global_prob (B,))\"\"\"\n",
    "        def sig(m): return torch.sigmoid(m(x).float()).squeeze(-1)\n",
    "        p_global = sig(self.global_model)\n",
    "        p_atel = sig(self.atel_model)\n",
    "        p_effu = sig(self.effu_model)\n",
    "        p_infi = sig(self.infi_model)\n",
    "        p_mass = torch.stack([sig(m) for m in self.mass_models]).mean(0)\n",
    "        p_nodu = torch.stack([sig(m) for m in self.nodu_models]).mean(0)\n",
    "        probs = torch.stack([p_atel, p_effu, p_infi, p_mass, p_nodu], dim=1)\n",
    "        return probs, p_global\n",
    "\n",
    "    @torch.no_grad()\n",
    "    def predict_binary(self, x):\n",
    "        probs, _ = self.forward(x)\n",
    "        return (probs >= self.thresholds.to(probs.device)).long()\n",
    "\n",
    "\n",
    "# Smoke test\n",
    "assert meta_path is not None, 'No hay meta_path — corre la celda anterior de prereqs'\n",
    "print(f'Construyendo Expert 1 desde {meta_path.name}...')\n",
    "expert1 = Expert1NIHEnsemble(meta_path, device=DEVICE)\n",
    "n_p = sum(p.numel() for p in expert1.parameters()) / 1e6\n",
    "print(f'  Params: {n_p:.1f}M (10 ConvNeXt-Tiny)')\n",
    "print(f'  Thresholds: {expert1.thresholds.cpu().numpy()}')\n",
    "with torch.no_grad():\n",
    "    dummy = torch.rand(2, 3, 224, 224).to(DEVICE)\n",
    "    probs, p_global = expert1(dummy)\n",
    "    print(f'  Output probs:  {tuple(probs.shape)}  (esperado: (2, 5))')\n",
    "    print(f'  Global prob:   {tuple(p_global.shape)} (esperado: (2,))')"
   ]
