    "---\n",
    "## 4. Task 3.1c — Clase `MoE_System` unificada\n",
    "\n",
    "Pipeline completo:\n",
    "\n",
    "```\n",
    "imagen → ViT-Tiny (frozen, CLS 192-d)\n",
    "              ↓\n",
    "        Router A Linear → softmax → argmax ∈ {0..4}\n",
    "              ↓\n",
    "  Experto seleccionado → predicción específica del dominio\n",
    "```"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 152,
   "id": "95208c3c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[OK] Clase MoE_System definida\n"
     ]
    }
   ],
   "source": [
    "class LinearRouter(nn.Module):\n",
    "    \"\"\"Router A (ganador ablation: 0.9990 acc).\"\"\"\n",
    "    def __init__(self, d_model=192, n_experts=5):\n",
    "        super().__init__()\n",
    "        self.gate = nn.Linear(d_model, n_experts)\n",
    "    def forward(self, z):\n",
    "        return self.gate(z)\n",
    "\n",
    "\n",
    "class MoE_System(nn.Module):\n",
    "    \"\"\"End-to-end MoE: ViT → Router A → Expert[winner].\"\"\"\n",
    "    EXPERT_NAMES = ['NIH', 'ISIC', 'OA', 'LUNA16', 'Pancreatic']\n",
    "\n",
    "    def __init__(self, meta_path_exp1, device='cuda'):\n",
    "        super().__init__()\n",
    "        self.device = device\n",
    "\n",
    "        # Backbone ViT-Tiny (frozen) para routing features\n",
    "        self.backbone = timm.create_model('vit_tiny_patch16_224', pretrained=True, num_classes=0).to(device)\n",
    "        self.backbone.eval()\n",
    "        for p in self.backbone.parameters():\n",
    "            p.requires_grad = False\n",
    "\n",
    "        # Router A (único entrenable en fase 3)\n",
    "        self.router = LinearRouter(d_model=192, n_experts=5).to(device)\n",
    "\n",
    "        # 5 expertos\n",
    "        self.expert1 = Expert1NIHEnsemble(meta_path_exp1, device=device)\n",
    "        self.expert2 = build_expert2_isic().to(device)\n",
    "        self.expert3 = build_expert3_oa().to(device)\n",
    "        self.expert4 = build_expert4_luna_mip().to(device)\n",
    "        self.expert5 = build_pancreatic_expert(pretrained=False, use_gradient_checkpointing=False).to(device)\n",
    "\n",
    "    def load_weights(self, ckpt_dir):\n",
    "        ckpt_dir = Path(ckpt_dir)\n",
    "\n",
    "        # Router A — partial-load (checkpoint viejo puede tener 4 expertos, modelo nuevo 5)\n",
    "        r = ckpt_dir / 'router_a_best.pth'\n",
    "        if r.exists():\n",
    "            st = torch.load(r, map_location=self.device, weights_only=False)\n",
    "            w_src, b_src = st['gate.weight'], st['gate.bias']\n",
    "            w_dst, b_dst = self.router.gate.weight.data, self.router.gate.bias.data\n",
    "            K = min(w_src.size(0), w_dst.size(0))\n",
    "            with torch.no_grad():\n",
    "                # Fila extra en zeros → logit 0 → no domina el softmax antes del fine-tune\n",
    "                nn.init.zeros_(w_dst); nn.init.zeros_(b_dst)\n",
    "                w_dst[:K].copy_(w_src[:K]); b_dst[:K].copy_(b_src[:K])\n",
    "            if w_src.size(0) == w_dst.size(0):\n",
    "                print(f'  [OK] Router A (full load, {K} expertos)')\n",
    "            else:\n",
    "                print(f'  [OK] Router A (partial: {w_src.size(0)}->{w_dst.size(0)}; '\n",
    "                      f'filas {K}+ inicializadas en zeros, se aprenden en fine-tune)')\n",
    "        else:\n",
    "            print(f'  [WARN] Router A no encontrado, pesos aleatorios')\n",
    "\n",
    "        # Expertos 2-5\n",
    "        for model, fname in [\n",
    "            (self.expert2, 'expert2_isic_best.pth'),\n",
    "            (self.expert3, 'expert3_oa_best.pth'),\n",
    "            (self.expert4, 'expert4_luna16_MIP_best.pth'),\n",
    "            (self.expert5, 'expert5_pancreatic_FAST_best.pth'),\n",
    "        ]:\n",
    "            p = ckpt_dir / fname\n",
    "            if not p.exists():\n",
    "                print(f'  [WARN] {fname} no encontrado'); continue\n",
    "            st = torch.load(p, map_location=self.device, weights_only=False)\n",
    "            st = st.get('model_state_dict', st)\n",
    "            try:\n",
    "                model.load_state_dict(st, strict=False)\n",
    "                print(f'  [OK] {fname}')\n",
    "            except Exception as e:\n",
    "                print(f'  [WARN] {fname}: {e}')\n",
    "        print('  [OK] Expert 1 ensemble (ya cargado en __init__)')\n",
    "\n",
    "    @torch.no_grad()\n",
    "    def _get_cls(self, x):\n",
    "        \"\"\"(B,3,224,224) → CLS token (B,192)\"\"\"\n",
    "        feats = self.backbone.forward_features(x)\n",
    "        return feats[:, 0, :]\n",
    "\n",
    "    def forward_routing(self, z):\n",
    "        \"\"\"Solo router (Task 3.3 fine-tuning).\"\"\"\n",
    "        return self.router(z)\n",
    "\n",
    "    @torch.no_grad()\n",
    "    def forward_end_to_end(self, x_2d_224, x_3d=None):\n",
    "        \"\"\"Pipeline completo. Procesa batch=1 (caso 3D); extensible a batch mayor.\n",
    "           Devuelve: dict con expert_id, expert_name, router_probs, expert_output.\"\"\"\n",
    "        z = self._get_cls(x_2d_224)\n",
    "        logits = self.router(z)\n",
    "        probs = F.softmax(logits, dim=-1)\n",
    "        eid = int(probs.argmax(dim=-1)[0].item())\n",
    "\n",
    "        if eid == 0:\n",
    "            out, _ = self.expert1(x_2d_224)\n",
    "        elif eid == 1:\n",
    "            out = torch.softmax(self.expert2(x_2d_224), dim=-1)\n",
    "        elif eid == 2:\n",
    "            out = torch.softmax(self.expert3(x_2d_224), dim=-1)\n",
    "        elif eid == 3:\n",
    "            out = torch.softmax(self.expert4(x_2d_224), dim=-1)\n",
    "        elif eid == 4:\n",
    "            if x_3d is None:\n",
    "                raise ValueError('Expert 5 (Pancreatic) requiere x_3d')\n",
    "            out = torch.softmax(self.expert5(x_3d), dim=-1)\n",
    "\n",
    "        return {\n",
    "            'expert_id':     eid,\n",
    "            'expert_name':   self.EXPERT_NAMES[eid],\n",
    "            'router_probs':  probs.cpu().numpy()[0],\n",
    "            'expert_output': out.cpu().numpy()[0],\n",
    "        }\n",
    "\n",
    "print('[OK] Clase MoE_System definida')"
   ]
  },
