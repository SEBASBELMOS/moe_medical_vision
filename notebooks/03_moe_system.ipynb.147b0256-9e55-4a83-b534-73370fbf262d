   "source": "# Task 3.7 — Fig 5: Heatmap de atención del ViT (attention rollout, Abnar & Zuidema 2020)\nfrom PIL import Image\nfrom torchvision import transforms as T\nimport torch.nn.functional as Fn\n\n# ─── Rutas oficiales (src/config.py) ────────────────────────────────────────\nDATA_RAW  = Path('/workspace/moe_medical_vision/data/raw')\nDATA_PROC = Path('/workspace/moe_medical_vision/data/processed')\nDATA_ROOTS = {\n    'NIH':    [DATA_RAW / 'nih'],\n    'ISIC':   [DATA_RAW / 'isic'],\n    'OA':     [DATA_RAW / 'osteoporosis' / 'KLGrade' / 'KLGrade'],\n    # LUNA16: volúmenes 3D pre-procesados (.npz con clave 'volume'); MIP on-the-fly.\n    'LUNA16': [DATA_PROC / 'luna16_highres', DATA_RAW / 'luna16'],\n}\n\n# Subcadenas a excluir al buscar imágenes (scripts, docs, evaluación suelta, cachés)\nEXCLUDE_SUBSTR = ('evaluationScript', 'evaluation_script', 'docs', 'scripts',\n                  'README', 'FROC', '__pycache__', 'sample')\n\ndef _find_img(cands):\n    for root in cands:\n        if not root.exists():\n            continue\n        # val_*.npz primero (split de validación), luego imágenes 2D, luego cualquier .npz\n        for ext in ('val_*.npz', '*.png', '*.jpg', '*.jpeg', '*.PNG', '*.JPG', '*.npz'):\n            hits = [p for p in sorted(root.rglob(ext))\n                    if not any(s.lower() in str(p).lower() for s in EXCLUDE_SUBSTR)]\n            if hits:\n                return hits[len(hits) // 2]\n    return None\n\ndef _load_as_pil(path):\n    \"\"\"Devuelve PIL RGB. Para .npz computa MIP (max intensity projection) del volumen 3D.\"\"\"\n    p = Path(path)\n    if p.suffix.lower() == '.npz':\n        d = np.load(p)\n        key = 'volume' if 'volume' in d.files else ('image' if 'image' in d.files else d.files[0])\n        vol = d[key]\n        while vol.ndim > 3:   # quita canal/batch dims hasta dejar (D,H,W)\n            vol = vol[0]\n        mip = vol.max(axis=0).astype(np.float32)\n        mn, mx = float(mip.min()), float(mip.max())\n        mip = (mip - mn) / max(mx - mn, 1e-6)\n        arr = (mip * 255).clip(0, 255).astype(np.uint8)\n        return Image.fromarray(arr).convert('RGB')\n    return Image.open(p).convert('RGB')\n\nsamples = {n: p for n, p in ((k, _find_img(v)) for k, v in DATA_ROOTS.items()) if p is not None}\nfor n, p in samples.items():\n    print(f'[OK]  {n:<7s} {p}')\nfor n in set(DATA_ROOTS) - set(samples):\n    print(f'[SKIP] {n}: no se encontraron imágenes válidas en {DATA_ROOTS[n]}')\n\nif not samples:\n    raise RuntimeError('Sin imágenes para heatmap. Edita DATA_ROOTS y re-ejecuta.')\n\n# ─── Monkey-patch de Attention (acepta attn_mask, is_causal de timm >=1.x) ──\nfrom timm.models.vision_transformer import Attention as _TimmAttn\n_orig_attn_fwd = _TimmAttn.forward\n\ndef _save_attn_fwd(self, x, attn_mask=None, is_causal=False):\n    B, N, C = x.shape\n    qkv = self.qkv(x).reshape(B, N, 3, self.num_heads, C // self.num_heads).permute(2, 0, 3, 1, 4)\n    q, k, v = qkv.unbind(0)\n    if hasattr(self, 'q_norm'): q = self.q_norm(q)\n    if hasattr(self, 'k_norm'): k = self.k_norm(k)\n    attn = (q @ k.transpose(-2, -1)) * self.scale\n    if attn_mask is not None:\n        attn = attn + attn_mask\n    attn = attn.softmax(dim=-1)\n    self._saved_attn = attn.detach()\n    attn = self.attn_drop(attn)\n    out = (attn @ v).transpose(1, 2).reshape(B, N, C)\n    return self.proj_drop(self.proj(out))\n\n_TimmAttn.forward = _save_attn_fwd\n\ntfm = T.Compose([\n    T.Resize((224, 224)),\n    T.ToTensor(),\n    T.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),\n])\n\ndef attention_rollout(attn_list):\n    \"\"\"Producto acumulativo con residual (Abnar & Zuidema 2020).\"\"\"\n    result = None\n    for A in attn_list:\n        A_mean = A.mean(dim=1)\n        I = torch.eye(A_mean.size(-1), device=A_mean.device).unsqueeze(0)\n        A_res = A_mean + I\n        A_res = A_res / A_res.sum(dim=-1, keepdim=True)\n        result = A_res if result is None else torch.bmm(A_res, result)\n    return result\n\n# ─── Generar heatmaps ───────────────────────────────────────────────────────\nmoe.backbone.eval(); moe.router.eval()\nn_samples = len(samples)\nfig, axes = plt.subplots(2, n_samples, figsize=(3.2 * n_samples, 6.6))\nif n_samples == 1:\n    axes = axes.reshape(2, 1)\n\ntry:\n    for col, (name, img_path) in enumerate(samples.items()):\n        img = _load_as_pil(img_path)\n        x = tfm(img).unsqueeze(0).to(DEVICE)\n\n        with torch.no_grad():\n            feats = moe.backbone.forward_features(x)\n            z = feats[:, 0, :]\n            probs_r = Fn.softmax(moe.router(z), dim=-1)\n            eid = int(probs_r.argmax(-1).item())\n            conf = float(probs_r[0, eid].item())\n\n        attn_list = [blk.attn._saved_attn for blk in moe.backbone.blocks]\n        roll = attention_rollout(attn_list)\n        cls_attn = roll[0, 0, 1:].reshape(14, 14)\n        hmap_up = Fn.interpolate(\n            cls_attn[None, None].float(), size=(224, 224),\n            mode='bilinear', align_corners=False\n        )[0, 0].cpu().numpy()\n        lo, hi = np.percentile(hmap_up, [5, 95])\n        hmap_up = np.clip((hmap_up - lo) / (hi - lo + 1e-8), 0, 1)\n\n        img_np = np.array(img.resize((224, 224)))\n\n        axes[0, col].imshow(img_np)\n        axes[0, col].set_title(f'{name}\\nRuta -> {moe.EXPERT_NAMES[eid]} (conf {conf:.2f})', fontsize=9)\n        axes[0, col].axis('off')\n\n        axes[1, col].imshow(img_np)\n        axes[1, col].imshow(hmap_up, cmap='jet', alpha=0.5)\n        axes[1, col].axis('off')\n\n    axes[0, 0].text(-0.08, 0.5, 'Imagen',\n                    transform=axes[0, 0].transAxes, rotation=90, va='center', fontsize=10)\n    axes[1, 0].text(-0.08, 0.5, 'Atencion ViT (rollout)',\n                    transform=axes[1, 0].transAxes, rotation=90, va='center', fontsize=10)\n\n    plt.suptitle('Mapas de atencion del ViT-Tiny con attention rollout', fontsize=11, y=1.00)\n    plt.tight_layout()\n    fig5_path = FIG_DIR / 'fig5_attention_heatmaps.pdf'\n    plt.savefig(fig5_path, bbox_inches='tight', dpi=140); plt.close()\n    print(f'\\n[OK] Fig 5 -> {fig5_path}')\nfinally:\n    _TimmAttn.forward = _orig_attn_fwd"
